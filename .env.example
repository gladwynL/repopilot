# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=repopilot
POSTGRES_DB=repopilot
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://repopilot:repopilot@localhost:5432/repopilot
CORS_ORIGINS=http://localhost:5173

# GitHub REST API. The token is optional: public repositories work without one
# (at a much lower rate limit). Use a fine-grained token with read-only
# "Pull requests" and "Contents" access for private repositories.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10

# AI review (OpenAI). Required for POST /api/reviews/github; everything else works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_OUTPUT_TOKENS=16000
OPENAI_MAX_RETRIES=2

# Review input budget. Token counts are estimated as ceil(characters / 3).
REVIEW_CHUNK_TOKEN_BUDGET=24000
REVIEW_MAX_CHUNKS=3
REVIEW_MAX_FILE_TOKENS=8000
REVIEW_MIN_CONFIDENCE=0.3

# Integration tests only (backend/tests/postgres). Point at a disposable database whose name
# ends in "_test", e.g. the Compose test-db service:
#   docker compose --profile test up -d --wait test-db
# TEST_DATABASE_URL=postgresql+psycopg://repopilot:repopilot@localhost:55432/repopilot_test
