# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=repopilot
POSTGRES_DB=repopilot
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://repopilot:repopilot@localhost:5432/repopilot
CORS_ORIGINS=http://localhost:5173

# GitHub REST API. The token is optional: public repositories work without one
# (at a much lower rate limit). Use a fine-grained token with read-only
# "Pull requests" and "Contents" access for private repositories.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
