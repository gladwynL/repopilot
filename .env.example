# RepoPilot configuration template. Placeholders only; never commit real values.
#
#   Local development:  cp .env.example .env               (defaults work as-is)
#   Production Compose: cp .env.example .env.production    (fill in every [prod] value)
#
# Legend: [prod] required in production · [opt] optional · [test] tests only
# .env and .env.* are gitignored (except this file).

# --- Application ---------------------------------------------------------------------------
# development | test | production. "production" enforces the [prod] values at startup and
# disables /docs.
ENVIRONMENT=development
# [prod] Public HTTPS origin; the OAuth callback is PUBLIC_APP_URL/api/auth/callback.
PUBLIC_APP_URL=
# Browser origins allowed to call the API cross-origin. Local dev: the Vite server.
# Same-origin production (Caddy serves app + API): leave empty. Never use "*".
CORS_ORIGINS=http://localhost:5173

# --- Database ------------------------------------------------------------------------------
# Used by docker-compose.yml (dev) and docker-compose.prod.yml. [prod] Use a long random
# password (e.g. `openssl rand -hex 24`); letters and digits avoid URL-encoding issues.
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=repopilot
POSTGRES_DB=repopilot
POSTGRES_PORT=5432
# Backend connection string. docker-compose.prod.yml builds this from POSTGRES_* itself.
# Managed databases: append ?sslmode=require (or the provider's recommended mode).
DATABASE_URL=postgresql+psycopg://repopilot:repopilot@localhost:5432/repopilot

# --- GitHub pull request ingestion ---------------------------------------------------------
# [opt] Read-only token for fetching PRs (higher rate limit, private repos). Fine-grained,
# read-only "Pull requests" + "Contents". Unrelated to sign-in below.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10

# --- OpenAI --------------------------------------------------------------------------------
# [prod] Needed for new reviews (cached reviews and history work without it).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_OUTPUT_TOKENS=16000
OPENAI_MAX_RETRIES=2

# --- Sign in with GitHub (authentication) --------------------------------------------------
# Off for local development. [prod] Must be true in production.
AUTH_ENABLED=false
# [prod] From a GitHub OAuth App whose callback URL is PUBLIC_APP_URL/api/auth/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# [prod] Comma-separated GitHub logins allowed to use the app (case-insensitive).
AUTH_ALLOWED_GITHUB_USERS=
# [prod] At least 32 random characters, e.g. `openssl rand -base64 48`. Signs session cookies;
# rotating it signs everyone out.
SESSION_SECRET=
# [opt] Session lifetime in seconds (default 8 hours).
SESSION_MAX_AGE_SECONDS=28800

# --- Review budgets and limits -------------------------------------------------------------
# Token counts are estimated as ceil(characters / 3).
REVIEW_CHUNK_TOKEN_BUDGET=24000
REVIEW_MAX_CHUNKS=3
REVIEW_MAX_FILE_TOKENS=8000
REVIEW_MIN_CONFIDENCE=0.3
# AI reviews that may run at once per backend process; extra cache misses get HTTP 429.
REVIEW_MAX_CONCURRENT=2

# --- Production Compose (docker-compose.prod.yml) ------------------------------------------
# [prod] Public host name; Caddy obtains a TLS certificate for it automatically.
SITE_ADDRESS=localhost
# [opt] Host ports and the private proxy network (the API trusts X-Forwarded-* only from it).
HTTP_PORT=80
HTTPS_PORT=443
EDGE_SUBNET=172.28.240.0/24

# --- Tests only ----------------------------------------------------------------------------
# [test] Disposable PostgreSQL for backend/tests/postgres; the name must end in "_test":
#   docker compose --profile test up -d --wait test-db
# TEST_DATABASE_URL=postgresql+psycopg://repopilot:repopilot@localhost:55432/repopilot_test
