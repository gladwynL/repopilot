# Frontend configuration. Vite exposes VITE_* variables to the browser bundle, so never put
# secrets here.

# RepoPilot API origin. Leave empty to use the dev/preview proxy (same origin, no CORS).
# Set it when the API is served elsewhere, e.g. VITE_API_BASE_URL=http://localhost:8000
# (the backend's CORS_ORIGINS must then include this frontend's origin).
VITE_API_BASE_URL=

# Where the dev/preview proxy forwards /api requests (not exposed to the browser).
API_PROXY_TARGET=http://localhost:8000
